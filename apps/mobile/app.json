{
  "expo": {
    "name": "Coffee Bean",
    "slug": "project-coffee-bean",
    "scheme": "coffeebean",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.projectcoffeebean.app"
    },
    "android": {
      "package": "org.projectcoffeebean.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Coffee Bean",
      "themeColor": "#FBF7F2",
      "backgroundColor": "#FBF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark.png",
          "imageWidth": 200,
          "backgroundColor": "#FBF7F2",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
